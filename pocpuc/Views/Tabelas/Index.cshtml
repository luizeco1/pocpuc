@model IEnumerable<PoCGastos.Models.ContextoGasto>
@using System.Globalization
@{
    ViewData["Title"] = "Tabelas de Gastos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Tabelas de Gastos</h2>
            <p class="text-muted">Crie tabelas de gastos separadas para organizar sua vida financeira, pessoal, profissional ou projetos especiais.</p>
        </div>
    </div>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            @if (item.Ativo)
                            {
                                <span class="badge bg-info text-dark mb-2">Ativo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary mb-2">Inativo</span>
                            }
                            <div>
                                <button type="button" class="btn btn-sm btn-outline-primary border-0" data-bs-toggle="modal" data-bs-target="#editar-@item.Id">Editar</button>
                                <form asp-action="Deletar" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger border-0">X</button>
                                </form>
                            </div>
                        </div>
                        <h5 class="card-title fw-bold">@item.Nome</h5>
                        <p class="card-text text-muted" style="font-size: 0.9em; min-height: 60px;">@item.Descricao</p>

                        <div class="d-flex justify-content-between mt-3">
                            <span class="text-muted">Total Gasto:</span>
                            <strong>R$ @item.TotalGasto.ToString("N2")</strong>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Limite Configurado:</span>
                            <strong>@(item.LimiteMensal.HasValue ? $"R$ {item.LimiteMensal.Value.ToString("N2")}" : "-")</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Lançamentos:</span>
                            <strong>@item.QuantidadeLancamentos itens</strong>
                        </div>

                        <button class="btn btn-outline-success w-100">Visualizar Lançamentos</button>
                    </div>
                </div>
            </div>

            <div class="modal fade" id="editar-@item.Id" tabindex="-1" aria-labelledby="editar-titulo-@item.Id" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <form asp-action="Editar" method="post">
                            <input type="hidden" name="id" value="@item.Id" />
                            <div class="modal-header">
                                <h5 class="modal-title fw-bold" id="editar-titulo-@item.Id">Editar Tabela</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                            </div>
                            <div class="modal-body">
                                <div class="mb-3">
                                    <label class="form-label fw-bold" style="font-size: 0.85em;">Nome da tabela</label>
                                    <input type="text" name="nome" class="form-control" value="@item.Nome" required>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-bold" style="font-size: 0.85em;">Descrição da tabela</label>
                                    <textarea name="descricao" class="form-control" rows="2">@item.Descricao</textarea>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-bold" style="font-size: 0.85em;">Limite mensal opcional (R$)</label>
                                    <input type="number" step="0.01" name="limiteMensal" class="form-control" value="@item.LimiteMensal?.ToString("0.00", CultureInfo.InvariantCulture)">
                                </div>

                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" role="switch" id="ativo-@item.Id" name="ativo" value="true" @(item.Ativo ? "checked" : "")>
                                    <label class="form-check-label fw-bold" for="ativo-@item.Id" style="font-size: 0.85em;">Tabela Ativa</label>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                                <button type="submit" class="btn btn-primary">Salvar</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }

        <div class="col-md-4 mb-4">
            <div class="card h-100 border-success border-2 border-dashed" style="border-style: dashed;">
                <div class="card-body bg-light">
                    <h5 class="card-title fw-bold">Criar Nova Tabela</h5>
                    <p class="card-text text-muted" style="font-size: 0.9em;">Configure uma nova tabela de despesas.</p>

                    <form asp-action="Criar" method="post">
                        <div class="mb-3">
                            <label class="form-label fw-bold" style="font-size: 0.85em;">Nome da tabela</label>
                            <input type="text" name="nome" class="form-control" placeholder="Ex: Controle de Assinaturas" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold" style="font-size: 0.85em;">Descrição da tabela</label>
                            <textarea name="descricao" class="form-control" rows="2" placeholder="Descreva do que se trata esta tabela"></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold" style="font-size: 0.85em;">Limite mensal opcional (R$)</label>
                            <input type="number" step="0.01" name="limiteMensal" class="form-control" placeholder="Ex: 2000,00">
                        </div>

                        <div class="mb-4 form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" id="ativoSwitch" name="ativo" value="true" checked>
                            <label class="form-check-label fw-bold" for="ativoSwitch" style="font-size: 0.85em;">Tabela Ativa</label>
                        </div>

                        <button type="submit" class="btn btn-success w-100 mt-2">Criar Tabela</button>
                </form>
                </div>
            </div>
        </div>
    </div>
</div>